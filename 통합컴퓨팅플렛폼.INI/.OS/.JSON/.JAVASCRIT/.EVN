            font=('Arial', 24, 'bold'),
            fg='#00ff88',
            bg='#1a1a1a'
        )
        title_label.pack(side=tk.TOP, pady=10)
        
        subtitle_label = tk.Label(
            header_frame,
            text="양자컴퓨터 + GPU + CPU 통합 컴퓨팅 플랫폼 🚀 전력효율 극대화",
            font=('Arial', 12),
            fg='#88ff88',
            bg='#1a1a1a'
        )
        subtitle_label.pack(side=tk.TOP)
    
    def create_system_status_panel(self):
        """시스템 상태 패널"""
