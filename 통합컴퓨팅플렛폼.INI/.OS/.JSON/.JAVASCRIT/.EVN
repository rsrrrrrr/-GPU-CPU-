            bg='#333', fg='white'
        )
        self.task_size.set(64)
        self.task_size.grid(row=1, column=1, padx=10, sticky='w')
        
        # 실행 버튼
        execute_btn = tk.Button(
            workload_frame,
            text="🚀 통합 컴퓨팅 실행",
            command=self.execute_workload,
            bg='#00ff88',
            fg='black',
            font=('Arial', 12, 'bold'),
            height=2
        )
        execute_btn.pack(pady=10)
    
    def create_monitoring_panel(self):
        """모니터링 패널"""
        monitor_frame = tk.LabelFrame(
            self.root,
            text="📊 실시간 모니터링",
            fg='#00ff88',
            bg='#1a1a1a',
