        )
        monitor_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)
        
        # 성능 지표
        metrics_frame = tk.Frame(monitor_frame, bg='#1a1a1a')
        metrics_frame.pack(fill=tk.X, padx=10, pady=5)
        
        # 전력 효율성 표시
        self.power_label = tk.Label(
            metrics_frame,
            text="⚡ 전력 효율성: 계산 중...",
            fg='#ffff00',
            bg='#1a1a1a',
            font=('Arial', 10, 'bold')
        )
        self.power_label.pack(side=tk.LEFT, padx=10)
        
        # 성능 점수 표시
        self.performance_label = tk.Label(
            metrics_frame,
            text="🏃 성능 점수: 계산 중...",
            fg='#ff8800',
