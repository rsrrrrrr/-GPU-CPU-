        }
    })

@app.route('/api/quantum/colors', methods=['POST'])
def generate_colors():
    """컬러 생성 API"""
    try:
        data = request.get_json()
        count = data.get('count', 10)
        mode = data.get('mode', 'hybrid')
        
        # 요청 제한
        if count > 1000:
            return jsonify({'error': '최대 1000개까지 생성 가능합니다'}), 400
        
        start_time = time.time()
        colors = QuantumProcessor.generate_colors(count, mode)
        processing_time = time.time() - start_time
        
        return jsonify({
            'colors': colors,
            'count': len(colors),
            'mode': mode,
            'processing_time': round(processing_time, 4),
            'performance': round(len(colors) / processing_time, 2)
        })
        
    except Exception as e:
        logger.error(f"컬러 생성 오류: {e}")
        return jsonify({'error': str(e)}), 500

@app.route('/api/optimization/auto', methods=['POST'])
def auto_optimize():
    """자동 최적화 API"""
    try:
        data = request.get_json()
        task_size = data.get('task_size', 64)
        power_mode = data.get('power_mode', 7)
        mode = data.get('mode', 'hybrid')
        
        result = QuantumProcessor.optimize_parameters(task_size, power_mode, mode)
        
        return jsonify({
            'optimization': result,
            'system_recommendations': {
                'cpu_intensive': system_metrics['cpu_count'] >= 4,
                'memory_available': system_metrics['memory_percent'] < 80,
                'recommended_mode': 'quantum' if system_metrics['cpu_count'] >= 8 else 'hybrid'
            }
        })
        
    except Exception as e:
        logger.error(f"최적화 오류: {e}")
        return jsonify({'error': str(e)}), 500

@app.route('/api/performance/test', methods=['POST'])
def performance_test():
    """성능 테스트 API"""
    try:
        data = request.get_json()
        test_duration = min(data.get('duration', 10), 60)  # 최대 60초
        
        results = {}
        modes = ['quantum', 'gpu', 'cpu', 'eco', 'hybrid']
        
        for mode in modes:
            start_time = time.time()
            test_colors = QuantumProcessor.generate_colors(100, mode)
            end_time = time.time()
            
            results[mode] = {
                'colors_generated': len(test_colors),
                'time_taken': round(end_time - start_time, 4),
                'colors_per_second': round(len(test_colors) / (end_time - start_time), 2)
            }
        
        # 최고 성능 모드 찾기
        best_mode = max(results.keys(), 
                       key=lambda x: results[x]['colors_per_second'])
        
        return jsonify({
            'test_results': results,
            'best_mode': best_mode,
            'test_completed_at': datetime.now().isoformat(),
            'system_info': {
                'cpu_usage': system_metrics['cpu_percent'],
                'memory_usage': system_metrics['memory_percent']
            }
        })
        
    except Exception as e:
        logger.error(f"성능 테스트 오류: {e}")
        return jsonify({'error': str(e)}), 500

@app.route('/api/logs')
def get_logs():
    """로그 조회 API"""
    try:
        log_file = 'logs/quantumunified.log'
        if os.path.exists(log_file):
            with open(log_file, 'r', encoding='utf-8') as f:
                lines = f.readlines()
                # 최근 100줄만 반환
                recent_lines = lines[-100:] if len(lines) > 100 else lines
                return jsonify({
                    'logs': [line.strip() for line in recent_lines],
                    'total_lines': len(lines)
                })
        else:
            return jsonify({
                'logs': ['로그 파일이 없습니다.'],
                'total_lines': 0
            })
    except Exception as e:
        logger.error(f"로그 조회 오류: {e}")
        return jsonify({'error': str(e)}), 500

