{
  "name": "quantumunified-pro",
  "version": "3.0.0",
  "description": "양자컴퓨터 + GPU + CPU 통합 혁신 플랫폼",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:python": "cd .. && python src/server.py",
    "dev:static": "live-server dist --port=8080 --host=localhost",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:python\" \"npm run dev:static\"",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "serve": "webpack serve --mode development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json,css,html}\"",
    "clean": "rimraf dist",
    "build:clean": "npm run clean && npm run build",
    "optimize": "npm run build && node scripts/optimize.js",
    "docker:build": "docker build -t quantumunified-pro .",
    "docker:run": "docker run -p 3000:3000 quantumunified-pro",
    "cluster": "NODE_ENV=production pm2 start src/server.js -i max --name quantumunified",
    "cluster:stop": "pm2 stop quantumunified",
    "cluster:restart": "pm2 restart quantumunified",
    "cluster:logs": "pm2 logs quantumunified",
    "benchmark": "node scripts/benchmark.js",
    "monitor": "node scripts/monitor.js"
  },
  "keywords": [
    "quantum-computing",
    "gpu-acceleration",
    "webgl",
    "performance",
    "web-workers",
    "nodejs",
    "express",
    "real-time"
  ],
  "author": "QuantumUnified Technologies",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "socket.io": "^4.7.3",
    "ws": "^8.14.2",
    "node-cron": "^3.0.2",
    "redis": "^4.6.10",
    "ioredis": "^5.3.2",
    "bull": "^4.12.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "canvas": "^2.11.2",
    "jimp": "^0.22.10",
    "gpu.js": "^2.16.0",
    "worker-farm": "^1.7.0"
  },
  "devDependencies": {
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "html-webpack-plugin": "^5.5.3",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "mini-css-extract-plugin": "^2.7.6",
    "terser-webpack-plugin": "^5.3.9",
    "html-minifier": "^4.0.0",
    "cssnano": "^6.0.1",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "rimraf": "^5.0.5",
    "pm2": "^5.3.0",
    "cross-env": "^7.0.3",
    "copyfiles": "^2.4.1",
    "workbox-webpack-plugin": "^7.0.0"
  },
  "optionalDependencies": {
    "sharp": "^0.32.6",
    "canvas": "^2.11.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quantumunified/quantumunified-pro.git"
  },
  "bugs": {
    "url": "https://github.com/quantumunified/quantumunified-pro/issues"
  },
  "homepage": "https://quantumunified.pro",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/workers/**/*.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/src/**/*.test.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "prefer-const": "error",
      "no-var": "error"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "pm2": {
    "apps": [
      {
        "name": "quantumunified-pro",
        "script": "src/server.js",
        "instances": "max",
        "exec_mode": "cluster",
        "env": {
          "NODE_ENV": "development",
          "PORT": 3000
        },
        "env_production": {
          "NODE_ENV": "production",
          "PORT": 3000
        },
        "log_file": "logs/pm2.log",
        "error_file": "logs/pm2-error.log",
        "out_file": "logs/pm2-out.log",
        "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
        "merge_logs": true,
        "max_memory_restart": "1G",
        "node_args": "--max-old-space-size=4096"
      }
    ]
  },
  "config": {
    "port": 3000,
    "host": "localhost"
  }
}
