#!/bin/bash

# QuantumUnified Pro 가상환경 자동 설치 스크립트
# 작성자: AI Assistant
# 버전: v3.0

echo "🚀 QuantumUnified Pro v3.0 가상환경 설치를 시작합니다..."

# 색상 정의
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 프로젝트 디렉토리 설정
PROJECT_NAME="quantumunified-pro"
PROJECT_DIR="$HOME/$PROJECT_NAME"

echo -e "${BLUE}📁 프로젝트 디렉토리 생성: $PROJECT_DIR${NC}"

# 기존 디렉토리가 있다면 백업
if [ -d "$PROJECT_DIR" ]; then
    echo -e "${YELLOW}⚠️  기존 프로젝트가 존재합니다. 백업을 생성합니다...${NC}"
    mv "$PROJECT_DIR" "${PROJECT_DIR}_backup_$(date +%Y%m%d_%H%M%S)"
fi

# 프로젝트 디렉토리 구조 생성
mkdir -p "$PROJECT_DIR"/{src/{js,css,workers},dist,docs,config,tests,logs}

cd "$PROJECT_DIR"

echo -e "${GREEN}✅ 프로젝트 디렉토리 구조 생성 완료${NC}"

# 1. Python 가상환경 설정
echo -e "${BLUE}🐍 Python 가상환경 설정 중...${NC}"

# Python 버전 확인
if command -v python3 &> /dev/null; then
    PYTHON_CMD="python3"
elif command -v python &> /dev/null; then
    PYTHON_CMD="python"
else
    echo -e "${RED}❌ Python이 설치되어 있지 않습니다. Python을 먼저 설치해주세요.${NC}"
    exit 1
fi

# 가상환경 생성
$PYTHON_CMD -m venv venv

# 가상환경 활성화 스크립트 확인
if [ -f "venv/bin/activate" ]; then
    source venv/bin/activate
    echo -e "${GREEN}✅ Python 가상환경 활성화 완료${NC}"
else
    echo -e "${RED}❌ Python 가상환경 생성 실패${NC}"
    exit 1
fi

# Python 패키지 설치
echo -e "${BLUE}📦 Python 패키지 설치 중...${NC}"
pip install --upgrade pip
pip install flask flask-cors gunicorn python-dotenv watchdog

# requirements.txt 생성
cat > requirements.txt << EOF
Flask==2.3.3
Flask-CORS==4.0.0
gunicorn==21.2.0
python-dotenv==1.0.0
watchdog==3.0.0
Pillow==10.0.1
numpy==1.24.3
redis==4.6.0
celery==5.3.1
pytest==7.4.2
black==23.7.0
flake8==6.0.0
EOF

pip install -r requirements.txt

echo -e "${GREEN}✅ Python 패키지 설치 완료${NC}"

# 2. Node.js 환경 설정
echo -e "${BLUE}📦 Node.js 환경 설정 중...${NC}"

# Node.js 버전 확인
if command -v node &> /dev/null; then
    NODE_VERSION=$(node --version)
    echo -e "${GREEN}✅ Node.js 발견: $NODE_VERSION${NC}"
    
    # npm 초기화
    npm init -y
    
    # 개발 의존성 설치
    echo -e "${BLUE}📦 Node.js 패키지 설치 중...${NC}"
    npm install --save-dev \
        live-server \
        webpack \
        webpack-cli \
        webpack-dev-server \
        html-webpack-plugin \
        css-loader \
        style-loader \
        terser-webpack-plugin \
        html-minifier \
        cssnano \
        postcss \
        autoprefixer \
        babel-loader \
        @babel/core \
        @babel/preset-env \
        eslint \
        prettier \
        jest \
        nodemon \
        concurrently
    
    # 프로덕션 의존성
    npm install \
        express \
        cors \
        helmet \
        compression \
        morgan \
        dotenv
    
    echo -e "${GREEN}✅ Node.js 패키지 설치 완료${NC}"
else
    echo -e "${YELLOW}⚠️  Node.js가 설치되어 있지 않습니다. Python 환경만 설정합니다.${NC}"
fi

# 3. Docker 환경 설정
echo -e "${BLUE}🐳 Docker 환경 설정 중...${NC}"

if command -v docker &> /dev/null; then
    echo -e "${GREEN}✅ Docker 발견${NC}"
    
    # Dockerfile 생성은 별도 파일로 처리
    echo -e "${BLUE}📝 Docker 설정 파일들을 생성합니다...${NC}"
else
    echo -e "${YELLOW}⚠️  Docker가 설치되어 있지 않습니다. 필요시 나중에 설치하세요.${NC}"
fi

# 4. 환경 변수 설정
echo -e "${BLUE}⚙️  환경 변수 설정 중...${NC}"

cat > .env << EOF
# QuantumUnified Pro 환경 설정
PROJECT_NAME=QuantumUnified Pro
VERSION=3.0.0
ENVIRONMENT=development

# 서버 설정
HOST=localhost
PORT=8080
PYTHON_PORT=5000
NODE_PORT=3000

# 성능 설정
MAX_WORKERS=4
MEMORY_LIMIT=512MB
GPU_ACCELERATION=true
QUANTUM_MODE=hybrid

# 보안 설정
SECRET_KEY=quantum_unified_secret_key_2024
CORS_ORIGIN=http://localhost:8080

# 로깅 설정
LOG_LEVEL=INFO
LOG_FILE=logs/quantumunified.log

# 데이터베이스 (선택사항)
DATABASE_URL=sqlite:///quantumunified.db
REDIS_URL=redis://localhost:6379

# API 설정
API_RATE_LIMIT=1000
API_TIMEOUT=30
EOF

echo -e "${GREEN}✅ 환경 변수 설정 완료${NC}"

# 5. Git 저장소 초기화
echo -e "${BLUE}📝 Git 저장소 초기화 중...${NC}"

if command -v git &> /dev/null; then
    git init
    
    # .gitignore 생성
    cat > .gitignore << EOF
# Dependencies
node_modules/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Environment variables
.env
.env.local
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Build outputs
dist/
build/
*.tgz
*.tar.gz

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp

# Database
*.db
*.sqlite
*.sqlite3

# Cache
.cache/
.parcel-cache/
.next/
.nuxt/

# Docker
.dockerignore
EOF
    
    git add .
    git commit -m "🚀 Initial commit: QuantumUnified Pro v3.0 setup"
    
    echo -e "${GREEN}✅ Git 저장소 초기화 완료${NC}"
else
    echo -e "${YELLOW}⚠️  Git이 설치되어 있지 않습니다.${NC}"
fi

# 6. 개발 서버 스크립트 생성
echo -e "${BLUE}🛠️  개발 도구 스크립트 생성 중...${NC}"

# 개발 서버 시작 스크립트
cat > start-dev.sh << 'EOF'
#!/bin/bash

echo "🚀 QuantumUnified Pro 개발 서버 시작..."

# 가상환경 활성화
if [ -f "venv/bin/activate" ]; then
    source venv/bin/activate
    echo "✅ Python 가상환경 활성화"
fi

# 환경 변수 로드
if [ -f ".env" ]; then
    export $(cat .env | grep -v '#' | xargs)
    echo "✅ 환경 변수 로드 완료"
fi

# 로그 디렉토리 생성
mkdir -p logs

# 개발 서버 선택
echo "개발 서버를 선택하세요:"
echo "1) Python Flask 서버 (포트 5000)"
echo "2) Node.js Express 서버 (포트 3000)"
echo "3) 정적 파일 서버 (포트 8080)"
echo "4) 모든 서버 동시 실행"

read -p "선택 (1-4): " choice

case $choice in
    1)
        echo "🐍 Python Flask 서버 시작..."
        python src/server.py
        ;;
    2)
        echo "📦 Node.js Express 서버 시작..."
        npm run dev
        ;;
    3)
        echo "📁 정적 파일 서버 시작..."
        python -m http.server 8080
        ;;
    4)
        echo "🚀 모든 서버 동시 실행..."
        if command -v npm &> /dev/null; then
            npm run dev:all
        else
            echo "Node.js가 설치되어 있지 않습니다. Python 서버만 시작합니다."
            python src/server.py
        fi
        ;;
    *)
        echo "❌ 잘못된 선택입니다."
        exit 1
        ;;
esac
EOF

chmod +x start-dev.sh

# 프로덕션 배포 스크립트
cat > deploy.sh << 'EOF'
#!/bin/bash

echo "🚀 QuantumUnified Pro 프로덕션 배포..."

# 가상환경 활성화
source venv/bin/activate

# 환경 변수 로드
export $(cat .env | grep -v '#' | xargs)

# 빌드 실행
echo "📦 프로덕션 빌드 중..."
if command -v npm &> /dev/null; then
    npm run build
fi

# 정적 파일 최적화
echo "⚡ 파일 최적화 중..."
python scripts/optimize.py

# 서버 시작
echo "🌐 프로덕션 서버 시작..."
gunicorn --bind 0.0.0.0:$PYTHON_PORT --workers $MAX_WORKERS src.server:app
EOF

chmod +x deploy.sh

echo -e "${GREEN}✅ 개발 도구 스크립트 생성 완료${NC}"

# 7. 설치 완료 메시지
echo
echo -e "${GREEN}🎉 QuantumUnified Pro 가상환경 설치가 완료되었습니다!${NC}"
echo
echo -e "${BLUE}📁 프로젝트 위치: $PROJECT_DIR${NC}"
echo
echo -e "${YELLOW}다음 단계:${NC}"
echo -e "1. ${GREEN}cd $PROJECT_DIR${NC}"
echo -e "2. ${GREEN}./start-dev.sh${NC} (개발 서버 시작)"
echo -e "3. 브라우저에서 ${GREEN}http://localhost:8080${NC} 접속"
echo
echo -e "${BLUE}사용 가능한 명령어:${NC}"
echo -e "• ${GREEN}./start-dev.sh${NC} - 개발 서버 시작"
echo -e "• ${GREEN}./deploy.sh${NC} - 프로덕션 배포"
echo -e "• ${GREEN}source venv/bin/activate${NC} - Python 가상환경 활성화"
echo -e "• ${GREEN}deactivate${NC} - 가상환경 비활성화"
echo
echo -e "${BLUE}프로젝트 구조:${NC}"
tree "$PROJECT_DIR" 2>/dev/null || ls -la "$PROJECT_DIR"
echo

# 자동으로 프로젝트 디렉토리로 이동
cd "$PROJECT_DIR"

echo -e "${GREEN}🚀 가상환경 설치 완료! 이제 파일 세팅을 진행합니다...${NC}"
